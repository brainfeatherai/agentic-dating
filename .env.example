# CleanAPIs (OpenAI-compatible gateway) — the site works without any key:
# analysis, dating and ranking all have grounded local engines.
CLEANAPIS_API_KEY=cc_...
ANALYSIS_MODEL=gpt-5.6-sol,claude-sonnet-5,kimi-k3
DATE_MODEL=claude-sonnet-5,gpt-5.6-sol
RANK_MODEL=gpt-5.6-sol,seed-2.1-pro

# Or talk to OpenAI directly instead of the gateway:
# OPENAI_API_KEY=sk-...
